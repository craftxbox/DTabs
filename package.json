{
    "name": "dtabs",
    "productName": "DTabs",
    "description": "Tabbed wrapper for Web Discord clients.",
    "keywords": [],
    "main": "./main.js",
    "version": "1.0.0",
    "author": "craftxbox",
    "scripts": {
        "dist": "npx tsc && npx rollup -c",
        "start": "npm run dist && electron .",
        "start-x11": "npm run dist && DISPLAY=:0 electron --ozone-platform=x11 .",
        "build": "npm run dist && node scripts/build.js",
        "package": "node scripts/package.js"
    },
    "type": "module",
    "license": "NCMIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/craftxbox/dtabs.git"
    },
    "dependencies": {
        "@electron/remote": "^2.1.2"
    },
    "devDependencies": {
        "@electron/packager": "^20.3.0",
        "axios": "^1.10.0",
        "electron": "^44.3.0",
        "glob": "^13.0.6",
        "rollup": "^4.44.1",
        "rollup-plugin-copy": "^3.5.0",
        "typescript": "~5.8.3"
    },
    "build": {
        "appId": "dtabs",
        "category": "dtabs",
        "win": {
            "target": "nsis"
        }
    }
}
